	measure 'National 4-Hour Departure Rate' =
			
			CALCULATE(
			    AVERAGE('gold_fact_measure_value'[value]),
			    REMOVEFILTERS('gold_dim_reporting_unit'),
			    'gold_fact_measure_value'[source_measure_code] = "MYH0005",
			    'gold_fact_measure_value'[reporting_unit_code] = "NAT",
			    'gold_fact_measure_value'[suppression_count] = 0
			)
		lineageTag: 74088e5e-58f9-4991-9f7c-90ad24bc387a

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hospital Display Filter' =
			
			VAR SelectedDisplay =
			    SELECTEDVALUE('Hospital Display'[Display], "Top 10")
			
			VAR HospitalRank =
			    RANKX(
			        ALLSELECTED(
			            'gold_dim_reporting_unit'[reporting_unit_key]
			        ),
			        [Median ED Departure Time],
			        ,
			        DESC,
			        DENSE
			    )
			
			RETURN
			    IF(
			        SelectedDisplay = "All"
			            || HospitalRank <= 10,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 8d3c17d7-2ee2-467e-b1b6-b05605d18775

		changedProperty = Name

	measure 'Median ED Departure Time (Display)' =
			
			VAR SelectedDisplay =
			    SELECTEDVALUE('Hospital Display'[Display], "All")
			
			VAR HospitalRank =
			    RANKX(
			        ALLSELECTED('gold_dim_reporting_unit'[reporting_unit_name]),
			        [Median ED Departure Time],
			        ,
			        DESC,
			        DENSE
			    )
			
			RETURN
			    IF(
			        SelectedDisplay = "Top 10" && HospitalRank > 10,
			        BLANK(),
			        [Median ED Departure Time]
			    )
		lineageTag: ba303e30-703d-4d26-9f04-a2ab532e469c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Elective Surgeries' =
			
			CALCULATE(
			    SUM('gold_fact_measure_value'[value]),
			    'gold_fact_measure_value'[source_measure_code] = "MYH0006",
			    'gold_fact_measure_value'[suppression_count] = 0,
			    'gold_dim_reported_measure'[reported_measure_name] IN {
			        "Urgent elective surgery",
			        "Semi-urgent elective surgery",
			        "Non-urgent elective surgery"
			    }
			)
		lineageTag: 75e43ed1-c83b-4e3f-b397-3c6d0d078564

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

